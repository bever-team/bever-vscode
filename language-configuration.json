{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [["(", ")"], ["\"", "\""]],
  "surroundingPairs": [["(", ")"], ["\"", "\""]],
  "folding": {
    "offSide": true,
    "markers": { "start": "^\\s*#\\s*region\\b", "end": "^\\s*#\\s*endregion\\b" }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(Entity|Action|Identity|Present|Listing|Details|Creating|Editing|Actions|Input|Create|Read|Update|Delete)\\b.*$",
    "decreaseIndentPattern": "^\\s*$"
  }
}
